+def load_engram_tables_from_disk(model: nn.Module, model_path: str) -> None:
+    """Load the frozen engram fp8 tables from ``model_path`` into the model's
+    ``EngramEmbedding`` modules.
+
+    Required for ``load_format=dummy`` (the RL rollout path): the dummy loader
+    skips ``model.load_weights()`` and fills every parameter — including the engram
+    ``weight``/``scale`` — with random values. The engram tables are constants that
+    the RL weight update does NOT carry, so without this they would stay garbage and
+    train/rollout parity blows up. This reuses each ``EngramEmbedding``'s own
+    ``weight_loader`` (row-sharded per TP rank) and ``finish_load``; it is a no-op for
+    models that have no engram layers.
+    """
+    import json
+
+    from safetensors import safe_open
+
+    inner = getattr(model, "model", None)
+    layers = getattr(inner, "layers", None)
+    if layers is None:
+        return
+    engram_layers = [
+        (i, layer.engram)
+        for i, layer in enumerate(layers)
+        if getattr(layer, "engram", None) is not None
+    ]
+    if not engram_layers:
+        return
+
+    index_path = os.path.join(model_path, "model.safetensors.index.json")
+    if not os.path.exists(index_path):
+        logger.warning(
+            "engram dummy-load: no safetensors index at %s; engram tables left uninitialized",
+            index_path,
+        )
+        return
+    with open(index_path) as f:
+        weight_map = json.load(f)["weight_map"]
+
+    logger.info(
+        "load_format=dummy: loading engram tables from %s for %d layer(s)",
+        model_path,
+        len(engram_layers),
+    )
+    for i, engram in engram_layers:
+        emb = engram.embed
+        for suffix, param in (("weight", emb.weight), ("scale", emb.scale)):
+            name = f"layers.{i}.engram.embed.{suffix}"
+            shard = weight_map.get(name)
+            if shard is None:
+                raise KeyError(f"engram dummy-load: {name} missing from {index_path}")
+            with safe_open(os.path.join(model_path, shard), framework="pt", device="cpu") as f:
+                # Pass the LAZY safetensors slice (not get_tensor) to the module's own
+                # weight_loader: _load_rows only indexes loaded_weight[row_start:row_end],
+                # so a PySafeSlice reads just this rank's rows from disk and we never
+                # materialize the full ~98GB fp8 table in host RAM per rank (that caused
+                # colocate host OOM). _load_rows also handles the shared/private layout.
+                param.weight_loader(param, f.get_slice(name))
+        emb.finish_load(label=f"dummy engram layer {i}")
diff --git a/python/sglang/srt/layers/engram_file.py b/python/sglang/srt/layers/engram_file.py
new file mode 100644
index 0000000..7e1e624
--- /dev/null
+++ b/python/sglang/srt/layers/engram_file.py
@@ -0,0 +1,62 @@
+"""Engram tables read from the checkpoint files instead of pinned host memory.
+
+`_HostTable` pins the whole table (~99GB per layer) so the GPU can gather rows directly. This
+table keeps the bytes in the safetensors shards (page cache, reclaimable) and gathers the rows a
+forward needs with parallel preads, dequantizing them on the GPU.
+
+Enabled with SGLANG_ENGRAM_FILE_CKPT=<checkpoint dir>.
+"""
+from __future__ import annotations
+
+import os
+from concurrent.futures import ThreadPoolExecutor
+
+import numpy as np
+import torch
+
+FP8_BLOCK_SIZE = 32
+
+
+class FileEngramTable:
+    def __init__(self, ckpt_dir: str, layer_id: int, dim: int, row_start: int, rows: int,
+                 threads: int = 64):
+        from sglang.srt.layers.moe.paged_experts.file_store import read_headers
+
+        meta = read_headers(ckpt_dir)
+        wpath, ws, we, _, wshape = meta[f"layers.{layer_id}.engram.embed.weight"]
+        spath, ss, se, _, sshape = meta[f"layers.{layer_id}.engram.embed.scale"]
+        self.w = np.memmap(wpath, dtype=np.uint8, mode="r", offset=ws, shape=wshape)
+        self.s = np.memmap(spath, dtype=np.uint8, mode="r", offset=ss, shape=sshape)
+        for mm in (self.w, self.s):
+            mm._mmap.madvise(2)  # MADV_RANDOM: no readahead on scattered row reads
+        self.dim = dim
+        self.row_start = row_start
+        self.rows = rows
+        self.tp_size = None
+        self.pool = ThreadPoolExecutor(threads)
+        self.threads = threads
+
+    def lookup(self, indices: torch.Tensor) -> torch.Tensor:
+        flat = indices.flatten().cpu().numpy()
+        owned = (flat >= self.row_start) & (flat < self.row_start + self.rows)
+        local = np.where(owned, flat - self.row_start, 0)
+        uniq, inv = np.unique(local, return_inverse=True)
+        parts = np.array_split(uniq, self.threads)
+        bounds = np.cumsum([0] + [len(p) for p in parts])
+        w = np.empty((len(uniq), self.dim), np.uint8)
+        s = np.empty((len(uniq), self.dim // FP8_BLOCK_SIZE), np.uint8)
+
+        def run(i):
+            if len(parts[i]):
+                w[bounds[i]: bounds[i + 1]] = self.w[parts[i]]
+                s[bounds[i]: bounds[i + 1]] = self.s[parts[i]]
+
+        list(self.pool.map(run, range(len(parts))))
+        for mm in (self.w, self.s):
+            mm._mmap.madvise(4)  # MADV_DONTNEED: drop the touched pages from RSS
+        u = len(uniq)
+        wt = torch.from_numpy(w).cuda().view(torch.float8_e4m3fn).float()
+        st = torch.from_numpy(s).cuda().view(torch.float8_e8m0fnu).float()
+        vals = (wt.view(u, -1, FP8_BLOCK_SIZE) * st.unsqueeze(-1)).view(u, self.dim).bfloat16()
+        out = vals[torch.from_numpy(inv).cuda()]
+        return out.view(*indices.shape, self.dim)
diff --git a/python/sglang/srt/layers/moe/paged_experts/file_store.py b/python/sglang/srt/layers/moe/paged_experts/file_store.py
new file mode 100644
index 0000000..9d76d08
--- /dev/null
+++ b/python/sglang/srt/layers/moe/paged_experts/file_store.py
@@ -0,0 +1,146 @@
+"""Paged experts whose host copy lives in the checkpoint files instead of RAM.
+
+`HostExpertStore` keeps every expert in pinned host memory, which needs the whole (dequantized)
+expert set resident. This store instead records where each expert's bytes sit in the safetensors
+shards and reads them on `page_in`, so only the K resident slots use device memory and nothing
+but page cache uses host memory.
+
+Enabled with SGLANG_FILE_EXPERTS=1; the checkpoint directory is SGLANG_FILE_EXPERTS_CKPT.
+"""
+from __future__ import annotations
+
+import json
+import os
+import struct
+from typing import Dict, List, Sequence, Tuple
+
+import torch
+
+_DT = {
+    "F8_E4M3": torch.float8_e4m3fn,
+    "F32": torch.float32,
+    "BF16": torch.bfloat16,
+    "F16": torch.float16,
+    "F8_E8M0": getattr(torch, "float8_e8m0fnu", torch.float32),
+    "I8": torch.int8,
+}
+
+# GPU tensor name -> checkpoint tensors that fill it, in destination order (w1 rows then w3).
+_SOURCES = {
+    "w13_weight": ("w1.weight", "w3.weight"),
+    "w2_weight": ("w2.weight",),
+    "w13_weight_scale_inv": ("w1.scale", "w3.scale"),
+    "w2_weight_scale_inv": ("w2.scale",),
+}
+
+
+def read_headers(ckpt_dir: str):
+    """name -> (path, start, end, dtype, shape) for every tensor in the sharded checkpoint."""
+    index = json.load(open(os.path.join(ckpt_dir, "model.safetensors.index.json")))["weight_map"]
+    meta = {}
+    for fn in sorted(set(index.values())):
+        path = os.path.join(ckpt_dir, fn)
+        with open(path, "rb") as f:
+            (n,) = struct.unpack("<Q", f.read(8))
+            hdr = json.loads(f.read(n))
+        base = 8 + n
+        for k, v in hdr.items():
+            if k == "__metadata__":
+                continue
+            meta[k] = (path, base + v["data_offsets"][0], base + v["data_offsets"][1],
+                       _DT[v["dtype"]], tuple(v["shape"]))
+    return meta
+
+
+class _LazyRows:
+    """Looks like an [E, ...] host tensor; rows are materialized from the checkpoint on access.
+
+    Writes are accepted and dropped: the loader's per-expert copies duplicate what is on disk.
+    """
+
+    is_lazy = True
+
+    def __init__(self, entries: List[List[tuple]], row_shape):
+        self.entries = entries  # per expert: list of (path, start, end, dtype, shape)
+        self.shape = (len(entries),) + tuple(row_shape)
+        self.dtype = entries[0][0][3]
+
+    def __len__(self):
+        return self.shape[0]
+
+    def _materialize(self, ids):
+        out = torch.empty((len(ids),) + tuple(self.shape[1:]), dtype=self.dtype)
+        for i, e in enumerate(ids):
+            offset = 0
+            for path, start, end, dtype, shape in self.entries[e]:
+                nbytes = end - start
+                with open(path, "rb") as f:
+                    f.seek(start)
+                    buf = f.read(nbytes)
+                part = out[i].reshape(-1).view(torch.uint8).narrow(0, offset, nbytes)
+                part.copy_(torch.frombuffer(bytearray(buf), dtype=torch.uint8))
+                offset += nbytes
+        return out
+
+    def __getitem__(self, key):
+        if isinstance(key, int):
+            return self._materialize([key if key >= 0 else len(self) + key])[0]
+        start, stop, step = key.indices(len(self))
+        assert step == 1
+        return self._materialize(range(start, stop))
+
+    def copy_(self, src):
+        return self
+
+    def expand_as(self, other):
+        return self
+
+    def to(self, *a, **k):
+        raise RuntimeError("LazyRows cannot move to a device; read rows instead")
+
+
+class FileExpertStore:
+    """Drop-in replacement for HostExpertStore backed by the checkpoint files."""
+
+    def __init__(self, layer, names: Sequence[str], num_experts: int, ckpt_dir: str):
+        if not ckpt_dir:
+            raise RuntimeError("SGLANG_FILE_EXPERTS needs SGLANG_FILE_EXPERTS_CKPT")
+        self.ckpt_dir = ckpt_dir
+        self.num_experts = num_experts
+        self.layer_id = int(layer.layer_id)
+        self.meta = read_headers(ckpt_dir)
+        self.host: Dict[str, _LazyRows] = {}
+        for name in names:
+            sources = [_SOURCES[name]] if name in _SOURCES else None
+            if sources is None:
+                raise RuntimeError(f"FileExpertStore: no source mapping for paged tensor {name}")
+            entries = [self._sources(name, e) for e in range(num_experts)]
+            self.host[name] = _LazyRows(entries, self._row_shape(name))
+
+    def _sources(self, name, expert):
+        return [self.meta[f"layers.{self.layer_id}.ffn.experts.{expert}.{s}"] for s in _SOURCES[name]]
+
+    def _row_shape(self, name):
+        shapes = [s[4] for s in self._sources(name, 0)]
+        if len(shapes) == 2:
+            return (shapes[0][0] + shapes[1][0],) + shapes[0][1:]
+        return shapes[0]
+
+    def page_in(self, layer, loads: Sequence[Tuple[int, int]]) -> None:
+        for name, rows in self.host.items():
+            gpu = getattr(layer, name).data
+            parts = len(_SOURCES[name])
+            for expert, slot in loads:
+                dst = gpu[slot]
+                if parts == 2:
+                    dst = dst.view(2, -1, *dst.shape[1:])
+                for part, (path, start, end, dtype, shape) in enumerate(self._sources(name, expert)):
+                    nbytes = end - start
+                    buf = torch.empty(nbytes, dtype=torch.uint8)
+                    with open(path, "rb") as f:
+                        f.seek(start)
+                        buf.copy_(torch.frombuffer(bytearray(f.read(nbytes)), dtype=torch.uint8))
+                    (dst[part] if parts == 2 else dst).copy_(buf.view(dtype).view(shape))
+
+    def bind_device_gather(self, layer):
+        raise RuntimeError("FileExpertStore does not support CUDA-graph gather; disable graphs")
