+        """
+        tensors = {name: t.to("cpu") for name, t in channel.get_iterator()}
+        lora_manager = self.get_model_runner().lora_manager
+        if lora_manager is None:
+            return False, "LoRA adapter sync requires --enable-lora."
+
+        name = recv_req.lora_name
