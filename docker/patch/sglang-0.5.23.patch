+def _disk_weight_tensors(model):
+    """Raw uint8 views of the model's unique CUDA parameter/buffer storages (stable order).
+
+    Storages, not tensors: parameters can be non-contiguous views, and reshaping them would copy.
+    """
+    seen, out = set(), []
+    tensors = [p for _, p in model.named_parameters()] + [b for _, b in model.named_buffers()]
+    for t in tensors:
+        if t is None or not t.is_cuda:
+            continue
+        st = t.untyped_storage()
+        key = st.data_ptr()
+        if key in seen or st.nbytes() == 0:
+            continue
+        seen.add(key)
+        out.append(torch.empty(0, dtype=torch.uint8, device=t.device).set_(st))
+    return out
+
+
+def _disk_backup_weights(model):
+    """SGLANG_DISK_WEIGHT_BACKUP=<file>: save the (post-processed) GPU weights before they are
+    released, so resume can restore them without host RAM (single-GPU colocated streaming)."""
+    import os
+    import time
+
+    path = os.environ.get("SGLANG_DISK_WEIGHT_BACKUP")
+    if not path:
+        return
+    t0 = time.time()
+    views = _disk_weight_tensors(model)
+    total = sum(v.numel() for v in views)
+    chunk = torch.empty(256 << 20, dtype=torch.uint8, pin_memory=True)
+    with open(path, "wb") as f:
+        for v in views:
+            for off in range(0, v.numel(), chunk.numel()):
+                n = min(chunk.numel(), v.numel() - off)
+                chunk[:n].copy_(v[off: off + n])
+                f.write(memoryview(chunk[:n].numpy()))
+    del chunk
+    logger.info(f"Disk weight backup: {len(views)} storages, {total / 2**30:.2f} GiB, "
+                f"{time.time() - t0:.1f}s -> {path}")
+
+
+def _disk_restore_weights(model):
+    import os
+    import time
+
+    path = os.environ.get("SGLANG_DISK_WEIGHT_BACKUP")
+    if not path or not os.path.exists(path):
+        return
+    t0 = time.time()
+    views = _disk_weight_tensors(model)
+    chunk = torch.empty(256 << 20, dtype=torch.uint8, pin_memory=True)
+    buf = chunk.numpy()
+    with open(path, "rb") as f:
+        for v in views:
+            for off in range(0, v.numel(), chunk.numel()):
+                n = min(chunk.numel(), v.numel() - off)
+                f.readinto(memoryview(buf[:n]))
+                v[off: off + n].copy_(chunk[:n])
+                torch.cuda.current_stream().synchronize()
+    del chunk
+    torch.cuda.empty_cache()
+    logger.info(f"Disk weight restore: {len(views)} storages, {time.time() - t0:.1f}s")
+
+
