+from dataclasses import dataclass
+from typing import Any
+
+from megatron.core.models.gpt import GPTModel as MCoreGPTModel
+
+from megatron.bridge.models.mla_provider import MLAModelProvider
+
+
+@dataclass
+class DeepSeekV41VLModelProvider(MLAModelProvider):
+    """Provider for DeepSeek-V4.1 with the vision tower.
+
+    The language-model fields come from ``DeepSeekV41Bridge.provider_bridge``. The bridge picks this
+    class instead of ``MLAModelProvider`` when the HF config has a ``vision_config``.
+    """
+
+    # The image embeddings are merged into the full-sequence embeddings first, then scattered.
+    scatter_embedding_sequence_parallel: bool = False
+
+    # HF ``vision_config`` as a dict (hidden_size, num_hidden_layers, patch_size, downsample_ratio ...).
+    vision_config: Any = None
+    # Id shared by all image tokens in ``input_ids`` (HF top-level ``image_token_id``).
+    image_token_id: int = 129264
+    # The tower is trained on a fixed recipe; the rollout engine and the trainer must see the same features.
+    freeze_vision_model: bool = True
+
+    def provide(self, pre_process=None, post_process=None, vp_stage=None):
+        from megatron.bridge.models.deepseek.deepseek_v41_vl_model import DeepSeekV41VLModel
+
+        model = DeepSeekV41VLModel(self, pre_process=pre_process, post_process=post_process, vp_stage=vp_stage)
+        model.freeze(freeze_vision_model=self.freeze_vision_model)
+        return model
+
+    def provide_language_model(self, pre_process=None, post_process=None, vp_stage=None) -> MCoreGPTModel:
+        # Read by the router (expert_bias_vl), Engram and the carry plan when the block spec is built.
+        self.v41_image_token_id = self.image_token_id
+        return super().provide(pre_process=pre_process, post_process=post_process, vp_stage=vp_stage)
