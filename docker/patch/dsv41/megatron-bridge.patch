+
+"""DeepSeek-V4.1 vision tower and aligner in plain torch.
+
+Mirrors ``sglang.srt.models.deepseek_v41_vit`` (the rollout engine) so that the trainer and the
+engine produce the same image features. Parameter names follow the HF checkpoint
+(``vision.patch_embed.proj``, ``vision.blocks.N.attn.wqkv`` ...), so the bridge maps them 1:1.
+The tower is not tensor-parallel: it is small and runs frozen, once per image.
+"""
+
+from functools import lru_cache
+
+import torch
+import torch.nn.functional as F
+from torch import nn
+
+
+class RMSNorm(nn.Module):
+    def __init__(self, dim: int, eps: float = 1e-6):
+        super().__init__()
+        self.eps = eps
+        self.weight = nn.Parameter(torch.ones(dim))
+
+    def forward(self, x: torch.Tensor) -> torch.Tensor:
+        h = x.float()
+        h = h * torch.rsqrt(h.square().mean(-1, keepdim=True) + self.eps)
+        return (h * self.weight.float()).to(x.dtype)
+
+
+@lru_cache(8)
+def get_vision_cos_sin(n_h: int, n_w: int, dim: int, theta: float):
+    """2D RoPE tables for an ``n_h x n_w`` patch grid, each ``[n_h*n_w, 1, dim]`` (fp32)."""
+    inv_freq = 1.0 / (theta ** (torch.arange(0, dim, 2, dtype=torch.float32) / dim))
+    hpos = torch.arange(n_h).unsqueeze(1).expand(n_h, n_w)
+    wpos = torch.arange(n_w).unsqueeze(0).expand(n_h, n_w)
+    freqs = torch.stack([hpos, wpos], dim=-1).reshape(-1, 2, 1).float() * inv_freq
+    freqs = freqs.flatten(1)
+    return freqs.cos().unsqueeze(1), freqs.sin().unsqueeze(1)
+
+
+def apply_rotary(x: torch.Tensor, cos: torch.Tensor, sin: torch.Tensor) -> torch.Tensor:
+    """Half-split rotary in fp32, cast back to the input dtype."""
+    dtype = x.dtype
+    x1, x2 = x.float().chunk(2, dim=-1)
+    return torch.cat([x1 * cos - x2 * sin, x2 * cos + x1 * sin], dim=-1).to(dtype)
+
+
+def image_token_types(n_llm_h: int, n_llm_w: int) -> torch.Tensor:
+    """Kind of each token in one image span: 0 start, 1 feature, 2 newline, 3 end."""
+    types = [0] + ([1] * n_llm_w + [2]) * n_llm_h + [3]
+    return torch.tensor(types, dtype=torch.int64)
+
+
+class PatchEmbed(nn.Module):
+    def __init__(self, patch_size: int, dim: int):
+        super().__init__()
+        self.proj = nn.Linear(3 * patch_size**2, dim)
+
+    def forward(self, x: torch.Tensor) -> torch.Tensor:
+        return self.proj(x.flatten(1))
+
+
+class Attention(nn.Module):
+    """Bidirectional attention over the patches of one image."""
+
+    def __init__(self, dim: int, n_heads: int):
+        super().__init__()
+        self.n_heads = n_heads
+        self.wqkv = nn.Linear(dim, 3 * dim)
+        self.wo = nn.Linear(dim, dim)
+
+    def forward(self, x: torch.Tensor, cos: torch.Tensor, sin: torch.Tensor) -> torch.Tensor:
+        seq, dim = x.shape
+        q, k, v = self.wqkv(x).split(dim, dim=-1)
+        q, k, v = (t.view(seq, self.n_heads, -1) for t in (q, k, v))
+        q, k = apply_rotary(q, cos, sin), apply_rotary(k, cos, sin)
+        q, k, v = (t.transpose(0, 1).unsqueeze(0) for t in (q, k, v))
+        out = F.scaled_dot_product_attention(q, k, v)
+        return self.wo(out.squeeze(0).transpose(0, 1).reshape(seq, dim))
+
+
+class MLP(nn.Module):
+    def __init__(self, dim: int, inter_dim: int):
+        super().__init__()
+        self.w1 = nn.Linear(dim, 2 * inter_dim, bias=False)
+        self.w2 = nn.Linear(inter_dim, dim, bias=False)
+
+    def forward(self, x: torch.Tensor) -> torch.Tensor:
+        gate, up = self.w1(x).chunk(2, dim=-1)
+        return self.w2(F.silu(gate) * up)
+
+
+class Block(nn.Module):
+    def __init__(self, dim: int, n_heads: int, inter_dim: int):
+        super().__init__()
+        self.norm1 = RMSNorm(dim)
+        self.attn = Attention(dim, n_heads)
+        self.norm2 = RMSNorm(dim)
+        self.mlp = MLP(dim, inter_dim)
+
+    def forward(self, x: torch.Tensor, cos: torch.Tensor, sin: torch.Tensor) -> torch.Tensor:
+        x = x + self.attn(self.norm1(x), cos, sin)
+        return x + self.mlp(self.norm2(x))
+
+
+class ViT(nn.Module):
+    def __init__(self, cfg: dict):
+        super().__init__()
+        dim, heads = cfg["hidden_size"], cfg["num_attention_heads"]
+        self.rope_dim = dim // heads // 2
+        self.rope_theta = float(cfg.get("rope_theta", 10000.0))
+        self.patch_embed = PatchEmbed(cfg["patch_size"], dim)
+        self.blocks = nn.ModuleList(
+            [Block(dim, heads, cfg["intermediate_size"]) for _ in range(cfg["num_hidden_layers"])]
+        )
+        self.norm = RMSNorm(dim)
+
+    def forward(self, patches: torch.Tensor, n_h: int, n_w: int) -> torch.Tensor:
+        x = self.patch_embed(patches)
+        cos, sin = get_vision_cos_sin(n_h, n_w, self.rope_dim, self.rope_theta)
+        cos, sin = cos.to(x.device), sin.to(x.device)
+        for block in self.blocks:
+            x = block(x, cos, sin)
+        return self.norm(x)
+
+
+class Aligner(nn.Module):
+    """Folds ``r x r`` ViT patches into one LLM-width feature."""
+
+    def __init__(self, vision_dim: int, dim: int, downsample_ratio: int):
+        super().__init__()
+        self.downsample_ratio = downsample_ratio
+        self.w1 = nn.Linear(vision_dim * downsample_ratio**2, dim)
+        self.w2 = nn.Linear(dim, dim)
+
+    def forward(self, x: torch.Tensor, n_h: int, n_w: int) -> torch.Tensor:
+        r = self.downsample_ratio
+        x = x.view(n_h, n_w, -1).permute(2, 0, 1)
+        x = F.pad(x, (0, -n_w % r, 0, -n_h % r))
+        x = F.unfold(x.unsqueeze(0), r, stride=r).squeeze(0).transpose(0, 1)
+        return self.w2(F.gelu(self.w1(x)))
