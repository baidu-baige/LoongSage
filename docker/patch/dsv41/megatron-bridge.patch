+"""DeepSeek-V4.1 with a vision tower: ViT + aligner in front of the Megatron language model.
+
+Image tokens in ``input_ids`` all have id ``image_token_id``. Each image owns a run of them, in
+the order of ``pixel_values``. Its span is ``[image_start, features (w per row) + image_newline per
+row, image_end]``, as built by the rollout engine. The vision modules exist only on the first
+pipeline stage. Every stage still passes ``input_ids`` to the language model, because the
+DeepSeek-V4.1 router and Engram read them (see ``megatron.core...dsv41``).
+"""
+
+import torch
+import torch.nn as nn
+from megatron.core.tensor_parallel.mappings import scatter_to_sequence_parallel_region
+from megatron.core.transformer.module import MegatronModule
+
+from megatron.bridge.models.deepseek.deepseek_v41_vit import ViT, Aligner, image_token_types
+
+
+def merge_image_spans(
+    embeds: torch.Tensor, input_ids: torch.Tensor, image_token_id: int, spans: list[torch.Tensor]
+) -> torch.Tensor:
+    """Write ``spans`` over the image tokens of ``embeds`` ``[b, s, h]``, in row-major (pad) order."""
+    mask = input_ids == image_token_id
+    n_tokens = int(mask.sum())
+    n_span = sum(s.shape[0] for s in spans)
+    if n_tokens != n_span:
+        raise ValueError(f"input_ids has {n_tokens} image tokens but the images provide {n_span}")
+    if not spans:
+        return embeds
+    return embeds.masked_scatter(mask.unsqueeze(-1), torch.cat(spans).to(embeds.dtype))
+
+
+class DeepSeekV41VLModel(MegatronModule):
+    def __init__(self, config, pre_process: bool = True, post_process: bool = True, vp_stage: int | None = None):
+        super().__init__(config=config)
+        assert config.context_parallel_size == 1, "DeepSeek-V4.1 vision does not support context parallelism"
+        self.pre_process = pre_process
+        self.post_process = post_process
+        self.vp_stage = vp_stage
+        self.image_token_id = config.image_token_id
+        if pre_process:
+            cfg = config.vision_config
+            self.downsample_ratio = cfg["downsample_ratio"]
+            self.vision = ViT(cfg)
+            self.aligner = Aligner(cfg["hidden_size"], config.hidden_size, self.downsample_ratio)
+            self.image_start = nn.Parameter(torch.zeros(config.hidden_size))
+            self.image_newline = nn.Parameter(torch.zeros(config.hidden_size))
+            self.image_end = nn.Parameter(torch.zeros(config.hidden_size))
+        self.language_model = config.provide_language_model(
+            pre_process=pre_process, post_process=post_process, vp_stage=vp_stage
+        )
+        self.share_embeddings_and_output_weights = config.share_embeddings_and_output_weights
+        self.shared_embedding_or_output_weight = self.language_model.shared_embedding_or_output_weight
+
+    def set_input_tensor(self, input_tensor) -> None:
+        self.language_model.set_input_tensor(input_tensor)
+
+    def freeze(self, freeze_vision_model: bool = True) -> None:
+        """Stop gradients for the vision tower, aligner and image marker embeddings."""
+        if self.pre_process and freeze_vision_model:
+            for module in (self.vision, self.aligner):
+                for p in module.parameters():
+                    p.requires_grad = False
+            for p in (self.image_start, self.image_newline, self.image_end):
+                p.requires_grad = False
+
+    def _image_spans(self, pixel_values: torch.Tensor, image_grid_hw: torch.Tensor) -> list[torch.Tensor]:
+        """Token spans ``[n_tokens, hidden]`` of each image, in image order."""
+        patches = pixel_values.to(self.vision.patch_embed.proj.weight.dtype)
+        r = self.downsample_ratio
+        spans, start = [], 0
+        for n_h, n_w in image_grid_hw.tolist():
+            n = n_h * n_w
+            features = self.aligner(self.vision(patches[start : start + n], n_h, n_w), n_h, n_w)
+            start += n
+            types = image_token_types(-(-n_h // r), -(-n_w // r)).to(features.device)
+            span = features.new_empty((len(types), features.shape[-1]))
+            span[types == 0] = self.image_start.to(span.dtype)
+            span[types == 1] = features
+            span[types == 2] = self.image_newline.to(span.dtype)
+            span[types == 3] = self.image_end.to(span.dtype)
+            spans.append(span)
+        if start != patches.shape[0]:
+            raise ValueError(f"image_grid_hw covers {start} patches but pixel_values has {patches.shape[0]}")
+        return spans
+
+    def _embed(self, input_ids, pixel_values, image_grid_hw) -> torch.Tensor:
+        """Embeddings of the full sequence with the images merged in, sequence-parallel scattered."""
+        embeds = self.language_model.embedding(input_ids=input_ids, position_ids=None).transpose(0, 1)
+        spans = []
+        if pixel_values is not None:
+            trainable = any(p.requires_grad for p in self.vision.parameters())
+            with torch.set_grad_enabled(torch.is_grad_enabled() and trainable):
+                spans = self._image_spans(pixel_values, image_grid_hw)
+        embeds = merge_image_spans(embeds, input_ids, self.image_token_id, spans).transpose(0, 1).contiguous()
+        if self.config.sequence_parallel:
+            pg = self.config._pg_collection
+            embeds = scatter_to_sequence_parallel_region(embeds, group=pg.tp if pg is not None else None)
+        return embeds
+
+    def forward(
+        self,
+        input_ids,
+        position_ids=None,
+        attention_mask=None,
+        pixel_values=None,
+        image_grid_hw=None,
+        **kwargs,
+    ):
+        decoder_input = self._embed(input_ids, pixel_values, image_grid_hw) if self.pre_process else None
+        return self.language_model(
+            input_ids=input_ids,
+            position_ids=position_ids,
+            attention_mask=attention_mask,
+            decoder_input=decoder_input,
+            **kwargs,
+        )
