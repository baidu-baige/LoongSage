+"""HF ``AutoConfig`` registration for DeepSeek-V4.1.
+
+``transformers`` (5.6) knows ``deepseek_v3`` and ``deepseek_v4`` natively but not
+``deepseek_v41``. V4.1's config schema is closest to V3 (a flat DeepSeek config with
+extra V4.1 fields), so we register a compat class based on ``DeepseekV3Config``.
+
+We deliberately do NOT base it on ``DeepseekV4Config``: that class's ``__post_init__``
+maps ``compress_ratios`` -> ``layer_types`` through a table that only knows V4's
+ratios {0,4,128} and raises ``KeyError`` on V4.1's {0,1,2}.
+
+Extra V4.1 fields (index/kv source layers, candidate-block params, engram params,
+compress ratios, o_groups/o_lora_rank, ...) are stored as plain attributes by
+``PretrainedConfig`` and read by the bridge via ``getattr``.
+"""
+
+from transformers import AutoConfig
+from transformers.models.deepseek_v3.configuration_deepseek_v3 import DeepseekV3Config
+
+
+class DeepseekV41Config(DeepseekV3Config):
+    """DeepSeek-V4.1 HF config (V3 schema + V4.1 fields carried as attributes)."""
+
+    model_type = "deepseek_v41"
+
+    def __init__(self, **kwargs):
+        # DeepseekV3Config.__init__ folds a top-level ``rope_theta`` into
+        # ``rope_scaling``/``rope_parameters`` and drops the standalone attribute,
+        # but the DeepSeek-V4 bridge reads ``hf_config.rope_theta`` eagerly. Preserve it.
+        rope_theta = kwargs.get("rope_theta", 10000.0)
+        super().__init__(**kwargs)
+        if not hasattr(self, "rope_theta") or self.rope_theta is None:
+            self.rope_theta = rope_theta
+
+
+def register_deepseek_v41_config() -> None:
+    """Register the ``deepseek_v41`` model type with ``AutoConfig`` (idempotent)."""
+    AutoConfig.register("deepseek_v41", DeepseekV41Config, exist_ok=True)
