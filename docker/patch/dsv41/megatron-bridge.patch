+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+
+"""HF ``AutoConfig`` registration for DeepSeek-V4.1.
+
+``transformers`` (5.6) knows ``deepseek_v3`` and ``deepseek_v4`` natively but not
+``deepseek_v41``. V4.1's config schema is closest to V3 (a flat DeepSeek config with
+extra V4.1 fields), so we register a compat class based on ``DeepseekV3Config``.
+
+We deliberately do NOT base it on ``DeepseekV4Config``: that class's ``__post_init__``
+maps ``compress_ratios`` -> ``layer_types`` through a table that only knows V4's
+ratios {0,4,128} and raises ``KeyError`` on V4.1's {0,1,2}.
+
+Extra V4.1 fields (index/kv source layers, candidate-block params, engram params,
+compress ratios, o_groups/o_lora_rank, ...) are stored as plain attributes by
+``PretrainedConfig`` and read by the bridge via ``getattr``.
+"""
+
+from dataclasses import dataclass
+from typing import Any, ClassVar
+
+from transformers import AutoConfig
+from transformers.models.deepseek_v3.configuration_deepseek_v3 import DeepseekV3Config
+
+from megatron.bridge.models.gpt.model_config import BridgeGPTMLAModelConfig
+from megatron.bridge.models.transformer_config import MLATransformerConfig, TransformerConfig
+
+
+class DeepseekV41Config(DeepseekV3Config):
+    """DeepSeek-V4.1 HF config (V3 schema + V4.1 fields carried as attributes).
+
+    Accepts both the flat schema and the ORIGINAL release schema, which wraps the text model
+    in ``text_config`` next to ``vision_config`` / ``quantization_config``. The wrapped form is
+    flattened into the text-only, MTP-free config the trainer builds: the text fields move to
+    the top level, ``num_nextn_predict_layers`` is set to 0 and the MTP entries of
+    ``compress_ratios`` are cut. ``quantization_config`` and ``vision_config`` are kept; the bridge
+    builds the vision tower only when ``vision_config`` is present (the trainer sets it to None
+    to run the same checkpoint as a text-only model).
+    """
+
+    model_type = "deepseek_v41"
+
+    def __init__(self, **kwargs):
+        text = kwargs.pop("text_config", None)
+        vision = kwargs.pop("vision_config", None)
+        if text is not None:
+            text = text if isinstance(text, dict) else text.to_dict()
+            kwargs.update({k: v for k, v in text.items() if k != "model_type"})
+            n_layers = kwargs["num_hidden_layers"]
+            if kwargs.get("compress_ratios") is not None:
+                kwargs["compress_ratios"] = list(kwargs["compress_ratios"])[:n_layers]
+            kwargs["num_nextn_predict_layers"] = 0
+        # DeepseekV3Config.__init__ folds a top-level ``rope_theta`` into
+        # ``rope_scaling``/``rope_parameters`` and drops the standalone attribute,
+        # but the DeepSeek-V4 bridge reads ``hf_config.rope_theta`` eagerly. Preserve it.
+        rope_theta = kwargs.get("rope_theta", 10000.0)
+        super().__init__(**kwargs)
+        if not hasattr(self, "rope_theta") or self.rope_theta is None:
+            self.rope_theta = rope_theta
+        # A plain dict: the bridge and the VL model read it with item access.
+        self.vision_config = vision if vision is None or isinstance(vision, dict) else vision.to_dict()
+
+
+def register_deepseek_v41_config() -> None:
+    """Register the ``deepseek_v41`` model type with ``AutoConfig`` (idempotent)."""
+    AutoConfig.register("deepseek_v41", DeepseekV41Config, exist_ok=True)
+
+
+@dataclass
+class DeepSeekV41TransformerConfig(MLATransformerConfig):
+    """MLA transformer config carrying the DeepSeek-V4.1-only fields.
+
+    The dsv41 block spec and the ported runtime modules read these ``v41_*``
+    attributes, which ``apply_v41_config`` populates from the HF config. Runtime-only
+    attributes (``v41_stage_bounds`` / ``v41_carry_state`` / ``v41_runtime`` and
+    ``dsa_topk_backend``) are set dynamically by ``get_dsv41_block_spec`` at build time
+    and are intentionally NOT declared here.
+    """
+
+    v41_kv_source_layer_ids: tuple[int, ...] = ()
+    v41_index_source_layer_ids: tuple[int, ...] = ()
+    v41_candidate_source_layer_id: int | None = None
+    v41_candidate_topk_blocks: int | None = None
+    v41_candidate_block_size: int | None = None
+    v41_engram_layer_ids: tuple[int, ...] = ()
+    v41_engram_num_embeddings: int | None = None
+    v41_engram_max_ngram_size: int | None = None
+    v41_engram_vocab_size: int | None = None
+    v41_engram_n_heads: int | None = None
+    v41_engram_head_dim: int | None = None
+    v41_engram_pad_token_id: int | None = None
+    v41_engram_compressed_vocab_size: int | None = None
+    # Checkpoint the engram tables are mmapped from (set by the bridge).
+    v41_hf_checkpoint: str | None = None
+    # Image-token id turns on image routing in the router / engram; None for text.
+    v41_image_token_id: int | None = None
+
+
+@dataclass(kw_only=True)
+class DeepSeekV41ModelConfig(BridgeGPTMLAModelConfig):
+    """Builder config for the DeepSeek-V4.1 language backbone (text, inner ``GPTModel``).
+
+    The builder counterpart of ``MLAModelProvider`` for V4.1: the standard GPT builder
+    constructs a ``GPTModel`` from the dsv41 block spec (carried on
+    ``transformer_layer_spec``). It nests ``DeepSeekV41TransformerConfig``.
+    """
+
+    transformer_config_class: ClassVar[type[TransformerConfig]] = DeepSeekV41TransformerConfig
+
+
+@dataclass(kw_only=True)
+class DeepSeekV41VLModelConfig(DeepSeekV41ModelConfig):
+    """Builder config for DeepSeek-V4.1 with the vision tower (``DeepSeekV41VLModel``).
+
+    Shares the V4.1 language config (and its ``v41_*`` transformer surface) and adds the
+    vision-language fields that ``DeepSeekV41VLModelProvider`` declared. ``vision_config``
+    is a plain dict, so the default config serialization round-trips it.
+    """
+
+    builder: ClassVar[str] = "megatron.bridge.models.deepseek.deepseek_v41_vl_builder.DeepSeekV41VLModelBuilder"
+
+    # Image embeddings are merged into the full-sequence embeddings first, then scattered.
+    scatter_embedding_sequence_parallel: bool = False
+    # HF ``vision_config`` as a dict (hidden_size, num_hidden_layers, patch_size, downsample_ratio ...).
+    vision_config: Any = None
+    # Id shared by all image tokens in ``input_ids`` (HF top-level ``image_token_id``).
+    image_token_id: int = 129264
+    # The tower trains on a fixed recipe; rollout engine and trainer must see the same features.
+    freeze_vision_model: bool = True
+
+
+def dsv41_block_spec(config, vp_stage=None):
+    """``get_dsv41_block_spec`` adapter for the builder path.
+
+    The GPT builder hands the OUTER model config to the ``transformer_layer_spec``
+    callable, but ``get_dsv41_block_spec`` reads and writes flat transformer-config
+    attributes. Unwrap to ``config.transformer`` (as the Kimi K3 spec does), then
+    delegate. On the legacy provider path the provider is passed directly and is not an
+    ``MCoreGPTModelConfig``, so it is used as-is.
+    """
+    from megatron.core.transformer.experimental_attention_variant.dsv41.deepseek_v41 import get_dsv41_block_spec
+    from megatron.training.models.gpt import GPTModelConfig as MCoreGPTModelConfig
+
+    if isinstance(config, MCoreGPTModelConfig):
+        config = config.transformer
+    return get_dsv41_block_spec(config, vp_stage=vp_stage)
diff --git a/src/megatron/bridge/models/deepseek/deepseek_v41_vit.py b/src/megatron/bridge/models/deepseek/deepseek_v41_vit.py
