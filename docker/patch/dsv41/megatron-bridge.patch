+
+"""Bridge for the DeepSeek-V4.1 (Flash) model family.
+
+DeepSeek-V4.1 shares the DeepSeek-V4 checkpoint serialisation (flat ``embed`` /
+``head`` / ``layers.N.attn.*`` / ``layers.N.ffn.*`` / ``layers.N.hc_*`` names)
+but is a distinct attention variant: per-layer compress ratios are {0,1,2}
+(vs V4's {0,4,128}), the sparse retrieval splits into separate KV-source and
+index-source layers with a two-level candidate-block pass, and each of two
+layers carries an additive n-gram "engram" memory. The V4.1 model math lives in
+``megatron.core.transformer.experimental_attention_variant.dsv41`` (registered as
+the ``dsv41_hybrid`` attention variant) and is wired in
+via ``get_dsv41_block_spec``; this bridge only maps the HF config and weight names on
+top of the V4 bridge.
+"""
+
+import functools
+import json
+import logging
+import struct
+from pathlib import Path
+
+import torch
+from megatron.core.models.gpt.gpt_model import GPTModel
+
+from megatron.bridge.models.conversion import quantization_utils
+from megatron.bridge.models.conversion.mapping_registry import MegatronMappingRegistry
+from megatron.bridge.models.conversion.model_bridge import MegatronModelBridge
+from megatron.bridge.models.conversion.param_mapping import AutoMapping, ColumnParallelMapping, ReplicatedMapping
+from megatron.core.transformer.experimental_attention_variant.dsv41.deepseek_v41 import (
+    apply_v41_config,
+    get_dsv41_block_spec,
+)
+from megatron.bridge.models.hf_pretrained.causal_lm import PreTrainedCausalLM
+from megatron.bridge.models.mla_provider import MLAModelProvider
+
+from .deepseek_v4_bridge import DeepSeekV4Bridge, _HCAlphaMapping
+from .deepseek_v41_config import register_deepseek_v41_config
+from .deepseek_v41_vl_provider import DeepSeekV41VLModelProvider
+
+logger = logging.getLogger(__name__)
+
+# Attribute path of the GPT model inside DeepSeekV41VLModel.
+_LM_PREFIX = "language_model."
+
+_SCALE_DTYPES = {
+    "F8_E8M0": getattr(torch, "float8_e8m0fnu", None),
+    "F32": torch.float32,
+    "BF16": torch.bfloat16,
+    "F16": torch.float16,
+}
+
+
+def _checkpoint_dir(hf_state_dict) -> str | None:
+    """Local directory of a safetensors-backed bridge ``StateDict``, else None."""
+    path = getattr(getattr(hf_state_dict, "source", None), "path", None)
+    return str(path) if path is not None else None
+
+
+@functools.lru_cache(maxsize=None)
+def _source_quant_layout(ckpt_dir: str | None) -> dict[str, tuple[str, str, tuple[int, ...], torch.dtype]]:
+    """``X.weight`` -> (weight dtype, ``X.scale``, scale shape, scale dtype) for every weight that
+    the checkpoint stores with a scale. Read from the safetensors headers only (no tensor data)."""
+    if not ckpt_dir:
+        return {}
+    header: dict[str, dict] = {}
+    for f in sorted(Path(ckpt_dir).glob("*.safetensors")):
+        with open(f, "rb") as fh:
+            (n,) = struct.unpack("<Q", fh.read(8))
+            header.update(json.loads(fh.read(n)))
+    layout = {}
+    for scale_name, sh in header.items():
+        if not scale_name.endswith(".scale"):
+            continue
+        weight_name = scale_name[: -len(".scale")] + ".weight"
+        wh = header.get(weight_name)
+        if wh is None:
+            continue
+        scale_dtype = _SCALE_DTYPES.get(sh["dtype"])
+        if scale_dtype is None:
+            raise RuntimeError(f"{scale_name}: unsupported scale dtype {sh['dtype']}")
+        layout[weight_name] = (wh["dtype"], scale_name, tuple(sh["shape"]), scale_dtype)
+    return layout
+
+# Make the checkpoint's `model_type: deepseek_v41` loadable by AutoConfig. This runs at
+# import of the deepseek bridge package, which `AutoBridge` triggers before it calls
+# AutoConfig.from_pretrained, so `AutoBridge.from_hf_pretrained` can dispatch V4.1.
+register_deepseek_v41_config()
+
+
+@MegatronModelBridge.register_bridge(
+    source="DeepseekV41ForCausalLM",
+    target=GPTModel,
+    provider=MLAModelProvider,
+    model_type="deepseek_v41",
+)
+class DeepSeekV41Bridge(DeepSeekV4Bridge):
+    """Megatron Bridge for DeepSeek-V4.1 causal language models.
+
+    Reuses the V4 provider/mapping and overrides only the V4.1 deltas:
+      * the transformer block is built by the V4.1 spec (``get_dsv41_block_spec``),
+        which swaps in the tilelang sparse-MLA attention, the engram gate, the
+        two-level indexer and the hyper-connection stream mixing;
+      * ``apply_v41_config`` copies the V4.1-only HF fields (kv/index source
+        layers, candidate-block params, engram params) onto the provider as
+        ``v41_*`` attributes;
+      * the indexer head count comes from ``index_n_heads`` (32 for V4.1);
+      * hash-MoE is disabled (``moe_n_hash_layers = 0``); V4.1 has no hash layers;
+      * ``v41_hf_checkpoint`` is recorded so the engram tables can be mmapped.
+    """
+
+    def provider_bridge(self, hf_pretrained: PreTrainedCausalLM) -> MLAModelProvider:
+        hf_config = hf_pretrained.config
+        # A checkpoint with a vision_config gets the VL provider (ViT + aligner + language model).
+        # Set it per call: the bridge instance outlives one conversion. The trainer sets
+        # vision_config to None to run the same checkpoint as a text-only model.
+        vision_config = getattr(hf_config, "vision_config", None)
+        self.PROVIDER_CLASS = DeepSeekV41VLModelProvider if vision_config else MLAModelProvider
+        provider = super().provider_bridge(hf_pretrained)
+        if vision_config:
+            image_token_id = getattr(hf_config, "image_token_id", None)
+            if image_token_id is None:
+                raise ValueError("DeepSeek-V4.1 config has a vision_config but no image_token_id")
+            provider.vision_config = dict(vision_config)
+            provider.image_token_id = int(image_token_id)
+        # V4.1 builds its block spec with the ported plugin, not the stock
+        # experimental-attention-variant builder. get_dsv41_block_spec runs the
+        # standard block scaffolding (the selector now dispatches "dsv41_hybrid" to
+        # the V4.1 attention natively), then swaps in the V4.1 layer / hyper-connection
+        # classes.
+        provider.experimental_attention_variant = "dsv41_hybrid"
+        provider.transformer_layer_spec = get_dsv41_block_spec
+
+        # V4.1-only config fields -> provider.v41_* (read by the ported modules).
+        apply_v41_config(provider, hf_config)
+
+        # Record the checkpoint path for the engram tables (mmapped per layer).
+        ckpt_path = getattr(hf_pretrained, "name_or_path", None) or getattr(
+            hf_pretrained, "model_name_or_path", None
+        )
+        provider.v41_hf_checkpoint = ckpt_path
+
+        # V4.1 indexer uses 32 heads (V4 used 64); the rest of the DSA indexer
+        # geometry (head_dim, topk) already matches via the V4 bridge.
+        provider.dsa_indexer_n_heads = hf_config.index_n_heads  # 32
+
+        # V4.1 has no hash-routed MoE layers (unlike V4-Flash's leading 3).
+        provider.moe_n_hash_layers = 0
+
+        # V4.1 MoE routing is UNGROUPED (flat top-k over all routed experts), matching
+        # both inference engines (SGLang DSV4 override use_grouped_topk=False; DeepInfer
+        # bf16_mega_gate has no group concept) and the V4.1 checkpoint config (config.json
+        # omits n_group/topk_group). However DeepseekV41Config subclasses DeepseekV3Config,
+        # so it inherits V3's n_group=8 / topk_group=4 defaults; AutoBridge's generic
+        # CONFIG_MAPPING then maps those leaked defaults to moe_router_num_groups=8 /
+        # moe_router_group_topk=4, silently enabling DeepSeek-V3 node-limited routing on the
+        # train side only. That makes Megatron select experts from 4-of-8 groups while the
+        # rollout engine selects freely -> a systematic train/infer routing divergence (the
+        # dominant is_approx_k3_kl gap when routing-replay is off). Force ungrouped.
+        provider.moe_router_num_groups = None
+        provider.moe_router_group_topk = None
+
+        # V4.1 runs its own tilelang sparse-MLA kernels inside the plugin, so it
+        # must NOT go through megatron's cuDNN/tilelang DSA kernel backend.
+        provider.dsa_kernel_backend = "none"
+        provider.apply_dsa_kernel_fusion = None
+
+        # V4.1 clamps the shared-expert activation too.
+        provider.activation_func_clamp_value = getattr(hf_config, "swiglu_limit", provider.activation_func_clamp_value)
+
+        return provider
+
+    # ------------------------------------------------------------------
+    # Quantized checkpoint import / export
+    # ------------------------------------------------------------------
+
+    def maybe_modify_loaded_hf_weight(self, hf_param, hf_state_dict):
+        """Dequantize the original V4.1 checkpoint to bf16 on import.
+
+        Same as V4, except the FP8 block size comes from ``quantization_config.weight_block_size``
+        (32x32 for V4.1): the shared helper assumes 128x128, which on V4.1 scales still produces
+        a weight of the right shape but with the wrong scale per block. MXFP4 experts carry
+        their K-tile size in the scale geometry and need no change.
+        """
+        if isinstance(hf_param, dict):
+            return {k: self.maybe_modify_loaded_hf_weight(v, hf_state_dict) for k, v in hf_param.items()}
+        weight = hf_state_dict[hf_param]
+        scale_key = hf_param[: -len(".weight")] + ".scale"
+        if weight.dtype != torch.float8_e4m3fn or not hf_param.endswith(".weight") or scale_key not in hf_state_dict:
+            return quantization_utils.maybe_dequantize_hf_quantized_weight(hf_param, hf_state_dict)
+        scale = hf_state_dict[scale_key]
+        if scale.ndim != 2 or scale.shape[0] == weight.shape[0]:
+            # per-row K tiles (e.g. the engram embed table): no block-size assumption involved
+            return quantization_utils.maybe_dequantize_hf_quantized_weight(hf_param, hf_state_dict)
+        block = self._fp8_block_size()
+        expected = tuple(-(-d // block) for d in weight.shape)
+        if tuple(scale.shape) != expected:
+            raise RuntimeError(
+                f"{hf_param}: FP8 scale {tuple(scale.shape)} does not match {block}x{block} blocks of "
+                f"weight {tuple(weight.shape)} (expected {expected})"
+            )
+        return quantization_utils.dequantize_fp8_e4m3fn_with_scale(weight, scale, name=hf_param, block_size=block)
+
+    def _fp8_block_size(self) -> int:
+        qcfg = getattr(self.hf_config, "quantization_config", None) or {}
+        qcfg = qcfg if isinstance(qcfg, dict) else qcfg.to_dict()
+        block = qcfg.get("weight_block_size")
+        if not block or len(block) != 2 or block[0] != block[1]:
+            raise RuntimeError(f"DeepSeek-V4.1 FP8 import needs a square weight_block_size, got {block!r}")
+        return int(block[0])
+
+    def maybe_modify_converted_hf_weight(self, task, converted_weights_dict, hf_state_dict):
+        """Re-quantize to the source checkpoint's own format, like V4, with two V4.1 differences.
+
+        * FP8 blocks use ``quantization_config.weight_block_size`` (32x32) instead of the shared
+          helper's 128x128, and MXFP4 groups come from the scale geometry.
+        * The source ``.scale`` tensors are never read: requantization only needs their shape and
+          dtype (the values are recomputed from the weight's amax), which are taken once from the
+          safetensors headers, so a weight sync does no checkpoint I/O.
+
+        Weights without a ``.scale`` companion in the source are returned unchanged. When
+        ``task.weight_dtype`` is set the weights are returned unchanged (plain-dtype export).
+        """
+        if task is not None and task.weight_dtype is not None:
+            return converted_weights_dict
+        layout = _source_quant_layout(_checkpoint_dir(hf_state_dict))
+        if not layout:
+            return converted_weights_dict
+        result: dict[str, torch.Tensor] = {}
+        for hf_param, weight in converted_weights_dict.items():
+            entry = layout.get(hf_param)
+            if entry is None:
+                result[hf_param] = weight
+                continue
+            weight_dtype, scale_name, scale_shape, scale_dtype = entry
+            # Only shape/dtype of the source scale are used by the quantizers.
+            like = torch.empty(scale_shape, dtype=scale_dtype, device="meta")
+            if weight_dtype in ("I8", "U8"):
+                q, s = quantization_utils.quantize_mxfp4_e2m1_like_scale(
+                    weight, like, name=hf_param, block_size=weight.shape[1] // scale_shape[1]
+                )
+            elif weight_dtype == "F8_E4M3":
+                q, s = quantization_utils.quantize_fp8_e4m3fn_like_scale(
+                    weight, like, name=hf_param, block_size=self._fp8_block_size()
+                )
+            else:
+                raise RuntimeError(f"{hf_param}: unsupported quantized source dtype {weight_dtype}")
+            result[hf_param] = q
+            result[scale_name] = s
+        return result
+
+    def mapping_registry(self) -> MegatronMappingRegistry:
+        """V4 weight-name mapping, with the indexer entries replaced for V4.1 and
+        the engram parameters added.
+
+        V4's indexer has a nested compressor and uses the ``indexer.scorer.weights_proj``
+        name; V4.1's indexer is flat (``wq_b`` / ``weights_proj`` / ``wk`` / ``k_norm``).
+        We drop all inherited ``*.indexer.*`` mappings and supply the V4.1 ones, then add
+        the three engram parameters (the fp8 embed table itself is loaded by the engram
+        module, not as a parameter, so it is not mapped here).
+
+        V4.1 also shards ``linear_o_group_proj`` across TP (dim 0), whereas V4 replicates it,
+        so that mapping is replaced with a column-parallel one.
+        """
+        def _keep(m):
+            mp = m.megatron_param
+            return ".indexer." not in mp and "linear_o_group_proj" not in mp
+
+        base = [m for m in super().mapping_registry().get_all_mappings() if _keep(m)]
+
+        # V4.1 grouped output projection is TP-sharded on dim 0 (n_local_groups = o_groups // TP).
+        o_group_mapping = [
+            ColumnParallelMapping(
+                "decoder.layers.*.self_attention.linear_o_group_proj",
+                "layers.*.attn.wo_a.weight",
+            ),
+        ]
+
+        indexer_prefix = "decoder.layers.*.self_attention.core_attention.indexer"
+        indexer_mappings = [
+            # all replicated in V4.1 (linear_wq_b/weights_proj are parallel_mode="duplicated",
+            # linear_wk is a plain nn.Linear, k_norm is an RMSNorm) -> no TP sharding.
+            ReplicatedMapping(f"{indexer_prefix}.linear_wq_b.weight", "layers.*.attn.indexer.wq_b.weight"),
+            ReplicatedMapping(f"{indexer_prefix}.linear_weights_proj.weight", "layers.*.attn.indexer.weights_proj.weight"),
+            ReplicatedMapping(f"{indexer_prefix}.linear_wk.weight", "layers.*.attn.indexer.wk.weight"),
+            ReplicatedMapping(f"{indexer_prefix}.k_norm.weight", "layers.*.attn.indexer.k_norm.weight"),
+        ]
+
+        # Engram (n-gram memory) params, present only on engram layers. The host FP8
+        # embedding table itself is loaded by the engram module (not a parameter).
+        engram_mappings = [
+            AutoMapping("decoder.layers.*.v41_engram.linear_wkv.weight", "layers.*.engram.wkv.weight"),
+            ReplicatedMapping("decoder.layers.*.v41_engram.q_weight", "layers.*.engram.q_weight"),
+            ReplicatedMapping("decoder.layers.*.v41_engram.k_weight", "layers.*.engram.k_weight"),
+        ]
+        text_mappings = [*base, *o_group_mapping, *indexer_mappings, *engram_mappings]
+        if not getattr(self.hf_config, "vision_config", None):
+            return MegatronMappingRegistry(*text_mappings)
+
+        # With the vision tower the Megatron model is DeepSeekV41VLModel: the GPT model sits under
+        # `language_model.`. The HF names stay flat (`layers.N...`, `embed.weight`). Prefix the
+        # mappings before the registry is built, since it compiles its regexes on construction.
+        for m in text_mappings:
+            m.megatron_param = _LM_PREFIX + m.megatron_param
+            if isinstance(m, _HCAlphaMapping):
+                m._megatron_post = _LM_PREFIX + m._megatron_post
+                m._megatron_res = _LM_PREFIX + m._megatron_res
+        vision_mappings = [
+            ReplicatedMapping("vision.**", "vision.**"),
+            ReplicatedMapping("aligner.**", "aligner.**"),
+            ReplicatedMapping("image_start", "image_start"),
+            ReplicatedMapping("image_newline", "image_newline"),
+            ReplicatedMapping("image_end", "image_end"),
+            # Selects the experts of image tokens; an fp32 buffer, not trained (see TopKRouter).
+            ReplicatedMapping(f"{_LM_PREFIX}decoder.layers.*.mlp.router.expert_bias_vl", "layers.*.ffn.gate.bias_vl"),
+        ]
+        return MegatronMappingRegistry(*text_mappings, *vision_mappings)
