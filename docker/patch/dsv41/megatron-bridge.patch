+
+"""Model builder for DeepSeek-V4.1 with the vision tower.
+
+``DeepSeekV41VLModelBuilder`` constructs ``DeepSeekV41VLModel`` the way the legacy
+``DeepSeekV41VLModelProvider.provide`` does: the ViT and the aligner on the first
+pipeline stage, and the DeepSeek-V4.1 language model from the GPT builder (so the inner
+``GPTModel`` is built from the dsv41 block spec and the ``v41_*`` transformer config).
+"""
+
+from functools import partial
+
+from megatron.core.pipeline_parallel.utils import (
+    is_pp_first_stage,
+    is_pp_last_stage,
+    is_vp_first_stage,
+    is_vp_last_stage,
+)
+from megatron.core.process_groups_config import ProcessGroupCollection
+
+from megatron.bridge.models.deepseek.deepseek_v41_config import DeepSeekV41VLModelConfig
+from megatron.bridge.models.deepseek.deepseek_v41_vl_model import DeepSeekV41VLModel
+from megatron.bridge.models.gpt.gpt_builder import GPTModelBuilder
+
+
+class DeepSeekV41VLModelBuilder(GPTModelBuilder):
+    """Combine the DeepSeek-V4.1 language model with the ViT vision tower and the aligner."""
+
+    def build_model(
+        self,
+        pg_collection: ProcessGroupCollection,
+        pre_process: bool | None = None,
+        post_process: bool | None = None,
+        vp_stage: int | None = None,
+    ) -> DeepSeekV41VLModel:
+        """Build one DeepSeek-V4.1 VL pipeline stage.
+
+        Args:
+            pg_collection: Process groups used for distributed construction.
+            pre_process: Whether this stage owns the embeddings, the ViT and the aligner.
+            post_process: Whether this stage owns the language-model output layer.
+            vp_stage: Optional virtual pipeline stage index.
+
+        Returns:
+            A DeepSeek-V4.1 VL model stage.
+
+        Raises:
+            TypeError: If the builder was given another model config.
+        """
+        model_config = self._model_config
+        if not isinstance(model_config, DeepSeekV41VLModelConfig):
+            raise TypeError(f"Expected DeepSeekV41VLModelConfig, got {type(model_config).__name__}.")
+
+        vp_size = model_config.virtual_pipeline_model_parallel_size
+        if pre_process is None:
+            pre_process = is_vp_first_stage(vp_stage=vp_stage, vp_size=vp_size) and is_pp_first_stage(pg_collection.pp)
+        if post_process is None:
+            post_process = is_vp_last_stage(vp_stage=vp_stage, vp_size=vp_size) and is_pp_last_stage(pg_collection.pp)
+
+        model = DeepSeekV41VLModel(
+            model_config.transformer,
+            pre_process=pre_process,
+            post_process=post_process,
+            vp_stage=vp_stage,
+            model_config=model_config,
+            build_language_model=partial(super().build_model, pg_collection),
+            pg_collection=pg_collection,
+        )
+        model.freeze(freeze_vision_model=model_config.freeze_vision_model)
+        return model
+
+
+__all__ = ["DeepSeekV41VLModelBuilder"]
