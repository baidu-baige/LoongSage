@@ -0,0 +1,22 @@
+"""Minimal stubs for the indexer-replay subsystem.
+
+Indexer replay threads the sparse-indexer top-k selection through an RL
+"replay" manager so the trainer can replay the exact indices the rollout
+engine chose. That capture is OFF by default and yields no measurable parity
+gain, so this port ships the disabled/no-op behavior: the top-k function is
+used as-is and nothing is registered on the module.
+
+If indexer replay parity is needed later, port the full replay manager here.
+"""
+
+
+class _NoopIndexerReplayManager:
+    def register_to_module(self, module, attr_name: str, stream_idx: int | None = None) -> None:
+        return
+
+    def get_topk_fn(self, old_topk_fn, return_probs: bool):
+        # replay disabled -> use the underlying top-k function unchanged
+        return old_topk_fn
+
+
+indexer_replay_manager = _NoopIndexerReplayManager()
