+class _CopyToModelParallelRegionFp32Grad(torch.autograd.Function):
+    """Pass the input to the model parallel region, all-reducing the gradient in fp32.
+
+    Same forward as ``_CopyToModelParallelRegion``; the backward accumulates the
+    reduction in fp32 and casts back to the gradient dtype. Used where a bf16
+    reduction would lose precision, e.g. DeepSeek-V4.1's replicated KV latent.
+    """
+
+    @staticmethod
+    def symbolic(graph, input_, group):
+        """Symbolic function for tracing."""
+        return input_
+
+    @staticmethod
+    def forward(ctx, input_, group):
+        """Forward function."""
+        ctx.group = group
+        return input_
+
+    @staticmethod
+    def backward(ctx, grad_output):
+        """Backward function."""
+        reduced = _reduce(grad_output.float(), ctx.group)
+        return reduced.to(grad_output.dtype), None
+
+
