+"""Looped core of Inkling-2-Mini (``inkling2_loop``).
+
+Decoder blocks ``[core_start, core_end)`` share their weights and run ``num_passes`` times.
+Every pass starts from the AttnRes state the prelude left; later passes see the previous
+pass only through messages. A message is an AttnRes mixture, with RMS-normalized values,
+over the blocks the previous core pass wrote and its final partial block. Each core block
+mixes one message into each of its Q, K, and V inputs and its MoE input through low-rank
+controllers: ``(1 - tanh(h @ forget.T)) * dest + tanh(h @ gain.T) * message`` with ``h``
+the BF16 down projection of the RMS-normalized ``(dest, message)`` pair. The rounding
+points follow SGLang's ``message_controllers`` kernel.
+"""
+
+from __future__ import annotations
+
+from collections.abc import Sequence
+
+import torch
+import torch.nn.functional as F
+from megatron.core import tensor_parallel
+from megatron.core.models.hybrid.hybrid_block import HybridStack
+from megatron.core.transformer.module import mark_keep_in_fp32
+from megatron.core.utils import make_viewless_tensor
+from torch import Tensor, nn
+
+from megatron.bridge.models.inkling.modeling_inkling2.ops import attn_res_mix
+
+
+CONTROLLER_EPS = 1e-6
+
+
+class Inkling2LoopController(nn.Module):
+    """One low-rank message controller; replicated across TP like the AttnRes queries."""
+
+    def __init__(self, width: int, rank: int, dtype: torch.dtype) -> None:
+        super().__init__()
+        device = torch.cuda.current_device()
+        self.down_weight = nn.Parameter(torch.zeros(rank, 2 * width, device=device, dtype=dtype))
+        self.gain_weight = nn.Parameter(torch.zeros(width, rank, device=device, dtype=dtype))
+        self.forget_weight = nn.Parameter(torch.zeros(width, rank, device=device, dtype=dtype))
+        for parameter in self.parameters():
+            # Each sequence-parallel rank sees different tokens; their gradients add.
+            parameter.sequence_parallel = True
+
+    def forward(self, dest: Tensor, message: Tensor) -> Tensor:
+        """Mix an FP32 ``message`` into an FP32 ``dest`` of the same shape; returns FP32."""
+        dest = dest.float()
+        message = message.float()
+        width = dest.shape[-1]
+        normed = torch.cat(
+            (
+                F.rms_norm(dest, (width,), eps=CONTROLLER_EPS),
+                F.rms_norm(message, (width,), eps=CONTROLLER_EPS),
+            ),
+            dim=-1,
+        ).to(self.down_weight.dtype)
+        hidden = F.linear(normed, self.down_weight)
+        # BF16 operands with FP32 products and accumulation, as the fused kernel computes them.
+        gain = torch.tanh(F.linear(hidden.float(), self.gain_weight.float()))
+        forget = torch.tanh(F.linear(hidden.float(), self.forget_weight.float()))
+        return (1.0 - forget) * dest + gain * message
+
+
+def loop_messages(bank: Sequence[Tensor], queries: Tensor) -> Tensor:
+    """FP32 messages ``[Q, ..., H]`` read from the previous pass's ``bank``."""
+    return attn_res_mix(list(bank), queries, normalize_values=True)
+
+
+class Inkling2LoopStack(HybridStack):
+    """HybridStack that runs the prelude once, the core ``num_passes`` times, and the coda once."""
+
+    def __init__(self, config, *args, **kwargs) -> None:
+        super().__init__(config, *args, **kwargs)
+        self.loop_core_start = config.inkling2_loop_core_start
+        self.loop_core_end = config.inkling2_loop_core_end
+        self.loop_num_passes = config.inkling2_loop_num_passes
+        num_core = self.loop_core_end - self.loop_core_start
+        # Row 2i holds core block i's attention query and row 2i + 1 its MLP query;
+        # the KV queries hold its K (2i) and V (2i + 1) queries.
+        for name in ("loop_queries", "loop_kv_queries"):
+            parameter = nn.Parameter(
+                torch.zeros(2 * num_core, config.hidden_size, device=torch.cuda.current_device(), dtype=torch.float32)
+            )
+            parameter.sequence_parallel = True
+            self.register_parameter(name, mark_keep_in_fp32(parameter))
+
+    def _core_queries(self, core_index: int) -> tuple[Tensor, Tensor]:
+        """Return the ``[3, H]`` Q/K/V message queries and the ``[1, H]`` MLP query of a core block."""
+        attn = torch.stack(
+            (
+                self.loop_queries[2 * core_index],
+                self.loop_kv_queries[2 * core_index],
+                self.loop_kv_queries[2 * core_index + 1],
+            )
+        )
+        return attn, self.loop_queries[2 * core_index + 1 : 2 * core_index + 2]
+
+    def _run_layer(self, layer, hidden_states, bank, queries, attention_mask, packed_seq_params, padding_mask):
+        def run(hidden_states, queries, *bank):
+            kwargs = {}
+            if bank:
+                kwargs["loop_messages"] = (bank, queries)
+            output, _ = layer(
+                hidden_states,
+                attention_mask=attention_mask,
+                packed_seq_params=packed_seq_params,
+                padding_mask=padding_mask,
+                **kwargs,
+            )
+            return output
+
+        bank = tuple(bank or ())
+        if self.config.recompute_granularity == "full" and self.training:
+            return tensor_parallel.checkpoint(
+                run, self.config.distribute_saved_activations, hidden_states, queries, *bank
+            )
+        return run(hidden_states, queries, *bank)
+
+    def forward(
+        self,
+        hidden_states: Tensor,
+        attention_mask: Tensor | None,
+        inference_context=None,
+        rotary_pos_emb: Tensor | None = None,
+        *,
+        packed_seq_params=None,
+        padding_mask=None,
+        **kwargs,
+    ):
+        """Run the looped decoder; see the module docstring."""
+        if self.loop_num_passes <= 1:
+            return super().forward(
+                hidden_states,
+                attention_mask,
+                inference_context,
+                rotary_pos_emb,
+                packed_seq_params=packed_seq_params,
+                padding_mask=padding_mask,
+                **kwargs,
+            )
+        if inference_context is not None:
+            raise ValueError("Inkling2 loop does not support Megatron's KV-cache inference")
+        if not (self.pre_process and self.post_process):
+            raise ValueError("Inkling2 loop requires the whole decoder on one pipeline stage")
+        hidden = self.config.hidden_size
+        run = lambda layer, h, bank=None, queries=None: self._run_layer(  # noqa: E731
+            layer, h, bank, queries, attention_mask, packed_seq_params, padding_mask
+        )
+        # Hybrid layer 2 * i is block i's attention and 2 * i + 1 its MoE.
+        core_lo, core_hi = 2 * self.loop_core_start, 2 * self.loop_core_end
+        for layer in self.layers[:core_lo]:
+            hidden_states = run(layer, hidden_states)
+        prelude_state = hidden_states
+        # The packed state is [partial, *blocks]; entering the core seals the prelude's partial.
+        num_prelude_blocks = prelude_state.shape[-1] // hidden - 1
+        for pass_idx in range(self.loop_num_passes):
+            bank = None
+            if pass_idx:
+                partial, *blocks = hidden_states.split(hidden, dim=-1)
+                bank = (*blocks[num_prelude_blocks + 1 :], partial)
+                hidden_states = prelude_state
+            for offset, layer in enumerate(self.layers[core_lo:core_hi]):
+                queries = None
+                if bank is not None:
+                    attn_queries, mlp_queries = self._core_queries(offset // 2)
+                    queries = attn_queries if offset % 2 == 0 else mlp_queries
+                hidden_states = run(layer, hidden_states, bank, queries)
+        for layer in self.layers[core_hi:]:
+            hidden_states = run(layer, hidden_states)
+
+        if self.post_layer_norm:
+            hidden_states = self.final_norm(hidden_states)
+        return make_viewless_tensor(inp=hidden_states, requires_grad=hidden_states.requires_grad, keep_graph=True)
