+"""Hugging Face <-> Megatron conversion for Inkling-2-Mini (``inkling2_loop``).
+
+The checkpoint is Inkling2 plus a looped core: per-block message controllers
+(``layers.N.controllers.{attn,k,v,mlp}``) on the core blocks and two FP32 tables of
+cross-pass message queries (``middle_cycle_cross_pass_queries`` and ``..._kv_queries``).
+"""
+
+from typing import Any
+
+from huggingface_hub.dataclasses import strict
+from transformers import AutoConfig, PretrainedConfig
+from transformers.models.auto.configuration_auto import CONFIG_MAPPING
+from transformers.models.inkling2.configuration_inkling2 import Inkling2Config, Inkling2TextConfig
+
+from megatron.bridge.models.conversion.mapping_registry import MegatronMappingRegistry
+from megatron.bridge.models.conversion.model_bridge import MegatronModelBridge
+from megatron.bridge.models.conversion.param_mapping import ReplicatedMapping
+from megatron.bridge.models.inkling.inkling2_bridge import _LLM, Inkling2Bridge
+from megatron.bridge.models.inkling.inkling2_config import Inkling2ModelConfig
+from megatron.bridge.models.inkling.modeling_inkling2.model import Inkling2Model
+
+
+if "inkling2_loop" in CONFIG_MAPPING:
+    Inkling2LoopConfig = CONFIG_MAPPING["inkling2_loop"]
+    Inkling2LoopTextConfig = Inkling2LoopConfig.sub_configs["text_config"]
+else:
+    # Transformers before v5.24.0 has no ``inkling2_loop`` classes.
+
+    @strict
+    class Inkling2LoopTextConfig(Inkling2TextConfig):
+        """Inkling2 text config with the looped-core settings of Inkling-2-Mini."""
+
+        model_type = "inkling2_loop_text"
+        loop_config: dict | None = None
+        # The Mini release omits these; SGLang defaults them to False.
+        pre_norm_pre_affine: bool = False
+        final_norm_pre_affine: bool = False
+
+    @strict
+    class Inkling2LoopConfig(Inkling2Config):
+        """Inkling-2-Mini config: Inkling2 with ``text_config.loop_config``."""
+
+        model_type = "inkling2_loop"
+        sub_configs_defaults = {**Inkling2Config.sub_configs_defaults, "text_config": Inkling2LoopTextConfig}
+
+    AutoConfig.register("inkling2_loop_text", Inkling2LoopTextConfig)
+    AutoConfig.register("inkling2_loop", Inkling2LoopConfig)
+
+
+@MegatronModelBridge.register_bridge(
+    source="Inkling2LoopForConditionalGeneration",
+    target=Inkling2Model,
+    model_type="inkling2_loop",
+)
+class Inkling2LoopBridge(Inkling2Bridge):
+    """Megatron Bridge for Inkling-2-Mini, whose decoder runs its core blocks several times."""
+
+    MODEL_CONFIG_CLASS = Inkling2ModelConfig
+
+    def hf_config_to_model_config_kwargs(self, hf_config: PretrainedConfig) -> dict[str, Any]:
+        """Add the loop settings to the Inkling2 kwargs."""
+        config_kwargs = super().hf_config_to_model_config_kwargs(hf_config)
+        loop = hf_config.text_config.loop_config
+        if loop is None:
+            return config_kwargs
+        if loop.get("is_varloop"):
+            raise ValueError("Variable-pass Inkling2 loops are not supported")
+        config_kwargs.update(
+            inkling2_loop_core_start=loop["core_start"],
+            inkling2_loop_core_end=loop["core_end"],
+            inkling2_loop_num_passes=loop["num_passes"],
+            inkling2_loop_gate_rank=loop["gate_rank"],
+        )
+        return config_kwargs
+
+    @classmethod
+    def megatron_to_hf_config(cls, model_config: Inkling2ModelConfig) -> dict[str, Any]:
+        """Write the release's ``inkling2_loop`` layout."""
+        hf_config = super().megatron_to_hf_config(model_config)
+        transformer = model_config.transformer
+        hf_config["architectures"] = ["Inkling2LoopForConditionalGeneration"]
+        hf_config["model_type"] = "inkling2_loop"
+        hf_config["text_config"]["loop_config"] = {
+            "core_start": transformer.inkling2_loop_core_start,
+            "core_end": transformer.inkling2_loop_core_end,
+            "num_passes": transformer.inkling2_loop_num_passes,
+            "gate_rank": transformer.inkling2_loop_gate_rank,
+            "is_varloop": False,
+        }
+        return hf_config
+
+    def mapping_registry(self) -> MegatronMappingRegistry:
+        """Add the controllers of the core blocks and the cross-pass queries to the Inkling2 mappings."""
+        mappings = list(super().mapping_registry().mappings)
+        loop = self.hf_config.text_config.loop_config
+        if loop is None:
+            return MegatronMappingRegistry(*mappings)
+        mappings += [
+            ReplicatedMapping("decoder.loop_queries", f"{_LLM}.middle_cycle_cross_pass_queries"),
+            ReplicatedMapping("decoder.loop_kv_queries", f"{_LLM}.middle_cycle_cross_pass_kv_queries"),
+        ]
+        for index in range(loop["core_start"], loop["core_end"]):
+            hf_controllers = f"{_LLM}.layers.{index}.controllers"
+            controllers = {
+                "attn": f"decoder.layers.{2 * index}.loop_controllers.attn",
+                "k": f"decoder.layers.{2 * index}.loop_controllers.k",
+                "v": f"decoder.layers.{2 * index}.loop_controllers.v",
+                "mlp": f"decoder.layers.{2 * index + 1}.loop_controller",
+            }
+            for name, megatron_prefix in controllers.items():
+                for weight in ("down_weight", "gain_weight", "forget_weight"):
+                    mappings.append(
+                        ReplicatedMapping(f"{megatron_prefix}.{weight}", f"{hf_controllers}.{name}.{weight}")
+                    )
+        return MegatronMappingRegistry(*mappings)
