+    @torch.no_grad()
+    def refresh_block_fp8_mxfp8_scale(self, layer: Module) -> None:
+        """Re-derive `weight_scale_inv_swizzled` IN PLACE from `weight_scale_inv`.
+
+        The swizzled copy is built once at load; an RL weight update (or dummy boot +
+        weight sync, or a memory-saver release of the weights region) only refreshes
+        `weight` / `weight_scale_inv`, so without this the MXFP8 GEMM keeps the stale
+        scales. Idempotent (scale-only; the CUTLASS / CuTe-DSL weight is untouched), so it
+        is safe to run after every partial update. In place keeps CUDA-graph pointers.
+        """
+        if not (self.block_fp8_as_mxfp8 and getattr(layer, "block_fp8_mxfp8_ready", False)):
+            return
+        backend = self.mxfp8_dense_backend
+        if not (backend.is_flashinfer_cutlass() or backend.is_flashinfer_cutedsl()):
+            raise RuntimeError(
+                f"MXFP8 dense backend {backend} reshuffles the weight at load and cannot be "
+                "hot-updated; use --fp8-gemm-backend flashinfer_cutedsl/flashinfer_cutlass."
+            )
+        from flashinfer import block_scale_interleave
+
+        n, k = layer.weight.shape
+        scale_u8 = block_fp8_scale_to_mxfp8_e8m0(
+            layer.weight_scale_inv.data, (n, k), self.weight_block_size
+        )
+        swizzled = block_scale_interleave(scale_u8.contiguous())
+        dst = layer.weight_scale_inv_swizzled
+        assert dst.numel() == swizzled.numel() and dst.dtype == swizzled.dtype, (
+            dst.shape, dst.dtype, swizzled.shape, swizzled.dtype)
+        dst.data.copy_(swizzled.view(dst.shape))
+
