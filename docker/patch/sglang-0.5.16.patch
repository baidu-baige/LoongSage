+    def update_weights_from_channel(self: WeightUpdater, recv_req):
+        """Receive weights from TransferMesh channel and update model in-place.
+
+        Uses channel_helper.create_receiver_channel() to lazily create or reuse a
+        process-local TransferMeshChannel based on the request parameters.
+        """
+        try:
+            from coda.utils.channel_helper import ChannelMeta, create_receiver_channel
+            from sglang.srt.utils.network import get_local_ip_auto
+
+            meta = ChannelMeta(
+                master_addr=recv_req.master_addr,
+                world_size=recv_req.world_size,
+                train_world_size=recv_req.train_world_size,
+                engine_id=recv_req.engine_id,
+                recreate=recv_req.recreate,
+                buffer_size_bytes=recv_req.buffer_size_bytes,
+                timeout=recv_req.timeout,
+                gloo_port=recv_req.gloo_port,
+                local_ip=get_local_ip_auto(),
+            )
+            channel = create_receiver_channel(meta)
+            self.get_model().load_weights(channel.get_iterator())
+            return True, "Succeeded to update weights from channel."
+        except Exception as e:
+            error_msg = f"Failed to update weights from channel: {e}."
+            logger.error(error_msg)
+            return False, error_msg
+
 
