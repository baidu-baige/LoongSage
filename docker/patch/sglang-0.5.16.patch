+    # Stream weights through, buffering only ".wo_a.weight"/".wo_a.scale" tensors so a
+    # weight can be paired with its scale regardless of arrival order. This keeps peak
+    # memory low, unlike dict(weights)/list(weights) which hold the whole model at once.
+    pending_weight = {}
+    pending_scale = {}
+
+    for name, tensor in weights:
+        if name.endswith(".wo_a.weight"):
+            prefix = name[: -len(".weight")]
+            scale = pending_scale.pop(prefix, None)
+            if scale is None:
+                pending_weight[prefix] = tensor
+            else:
+                yield name, _dequant_fp8(tensor, scale)
+        elif name.endswith(".wo_a.scale"):
+            prefix = name[: -len(".scale")]
+            weight = pending_weight.pop(prefix, None)
+            if weight is None:
+                pending_scale[prefix] = tensor
+            else:
+                yield prefix + ".weight", _dequant_fp8(weight, tensor)
+        else:
+            yield name, tensor
+
+    # Unpaired leftovers (e.g. no scales present -> not an fp8 checkpoint): pass through.
